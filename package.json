{
  "name": "biometric-inference-proxy",
  "version": "0.1.0",
  "description": "OpenAI-compatible proxy that conditions inference parameters on Whoop biometric recovery data",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "poll": "tsx scripts/poll.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.7",
    "@upstash/redis": "^1.34.3",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
