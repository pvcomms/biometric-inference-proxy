# Anthropic
ANTHROPIC_API_KEY=

# Whoop OAuth
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Proxy config
PORT=3000
POLL_INTERVAL_MS=600000
PROXY_API_KEY=               # optional: require callers to pass this as Bearer token
DEFAULT_MODEL=claude-sonnet-4-6

# Override biometric params (optional, for testing)
FORCE_MODE=                  # red|yellow|green|peak — bypasses Whoop polling
